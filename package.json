{
  "name": "upskill-portal",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix server run dev",
    "dev:web": "npm --prefix client run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "lint": "npm --prefix server run lint && npm --prefix client run lint",
    "db:generate": "npm --prefix server run db:generate",
    "db:migrate": "npm --prefix server run db:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}