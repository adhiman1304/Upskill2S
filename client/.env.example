# Base URL of the Express API (server/.env PORT).
VITE_API_BASE_URL=http://localhost:4000

# Microsoft Entra sign-in (SPA app registration and the API scope it requests).
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=

# Local development only: skip Entra sign-in. Must match DEV_AUTH_BYPASS=true in server/.env.
VITE_DEV_AUTH_BYPASS=false
# Shows admin navigation in local bypass mode. UI only: the server decides admin access (ADMIN_OBJECT_IDS).
VITE_LOCAL_IS_ADMIN=false
