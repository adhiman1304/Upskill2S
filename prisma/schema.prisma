generator client {
  provider = "prisma-client"
  output   = "../server/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String          @id @default(cuid())
  tenantId    String
  objectId    String
  displayName String
  certifications Certification[]
  resources   Resource[]
  bookmarks   Bookmark[]
  helpfulVotes ResourceHelpfulVote[]
  reports     ResourceReport[] @relation("ResourceReportAuthor")
  reviewedResources Resource[] @relation("ResourceReviewer")
  moderatedResources Resource[] @relation("ResourceModerator")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([tenantId, objectId])
}

model Certification {
  id          String     @id @default(cuid())
  provider    String
  providerKey String
  code        String
  codeKey     String
  title       String
  description String     @default("")
  status      String     @default("ACTIVE")
  examVersion String?
  examUpdatedAt DateTime?
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  resources   Resource[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([providerKey, codeKey])
  @@index([providerKey])
  @@index([updatedAt])
}

model Resource {
  id              String        @id @default(cuid())
  type            String
  title           String
  content         String        @default("{}")
  topics          String        @default("[]")
  language        String        @default("en")
  estimatedMinutes Int?
  sourceName      String?
  sourceUrl       String?
  rightsConfirmed Boolean       @default(false)
  isVisible       Boolean       @default(true)
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?         @relation("ResourceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  hiddenAt        DateTime?
  hiddenById      String?
  hiddenBy        User?         @relation("ResourceModerator", fields: [hiddenById], references: [id], onDelete: SetNull)
  storageName     String?
  originalFileName String?
  mimeType        String?
  fileSize        Int?
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  bookmarks       Bookmark[]
  helpfulVotes    ResourceHelpfulVote[]
  reports         ResourceReport[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([certificationId, type])
  @@index([createdById])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([userId, createdAt])
}

model ResourceHelpfulVote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([resourceId])
}

model ResourceReport {
  id          String   @id @default(cuid())
  category    String
  message     String   @default("")
  status      String   @default("OPEN")
  reporterId  String
  reporter    User     @relation("ResourceReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([resourceId])
}