generator client {
  provider = "prisma-client"
  output   = "../server/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String          @id @default(cuid())
  tenantId    String
  objectId    String
  displayName String
  certifications Certification[]
  resources   Resource[]
  bookmarks   Bookmark[]
  helpfulVotes ResourceHelpfulVote[]
  reports     ResourceReport[] @relation("ResourceReportAuthor")
  reviewedResources Resource[] @relation("ResourceReviewer")
  moderatedResources Resource[] @relation("ResourceModerator")
  communityPosts CommunityPost[] @relation("CommunityPostAuthor")
  communityComments CommunityComment[] @relation("CommunityCommentAuthor")
  providerKeys           UserProviderKey[]
  researchJobs           ResearchJob[]
  studyBriefs            StudyBrief[]
  checklistProgress      ChecklistProgress[]
  briefFeedback          BriefFeedback[]
  followedCertifications UserCertification[]
  intakeSessions         IntakeSession[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([tenantId, objectId])
}

model Certification {
  id          String     @id @default(cuid())
  provider    String
  providerKey String
  code        String
  codeKey     String
  title       String
  description String     @default("")
  status      String     @default("ACTIVE")
  examVersion String?
  examUpdatedAt DateTime?
  officialUrl String?
  aliases     String     @default("[]") // JSON array of alternative names/codes
  isCatalog   Boolean    @default(false)
  lastResearchedAt DateTime?
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  resources   Resource[]
  researchJobs      ResearchJob[]
  studyBriefs       StudyBrief[]
  checklistProgress ChecklistProgress[]
  followers         UserCertification[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([providerKey, codeKey])
  @@index([providerKey])
  @@index([updatedAt])
}

model Resource {
  id              String        @id @default(cuid())
  type            String
  title           String
  content         String        @default("{}")
  topics          String        @default("[]")
  language        String        @default("en")
  estimatedMinutes Int?
  sourceName      String?
  sourceUrl       String?
  rightsConfirmed Boolean       @default(false)
  isVisible       Boolean       @default(true)
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?         @relation("ResourceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  hiddenAt        DateTime?
  hiddenById      String?
  hiddenBy        User?         @relation("ResourceModerator", fields: [hiddenById], references: [id], onDelete: SetNull)
  storageName     String?
  originalFileName String?
  mimeType        String?
  fileSize        Int?
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  bookmarks       Bookmark[]
  helpfulVotes    ResourceHelpfulVote[]
  reports         ResourceReport[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([certificationId, type])
  @@index([createdById])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([userId, createdAt])
}

model ResourceHelpfulVote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([resourceId])
}

model ResourceReport {
  id          String   @id @default(cuid())
  category    String
  message     String   @default("")
  status      String   @default("OPEN")
  reporterId  String
  reporter    User     @relation("ResourceReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([resourceId])
}

model CommunityPost {
  id        String            @id @default(cuid())
  kind      String
  title     String
  body      String
  authorId  String
  author    User              @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments  CommunityComment[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([createdAt])
  @@index([authorId, createdAt])
}

model CommunityComment {
  id        String        @id @default(cuid())
  body      String
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation("CommunityCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

model UserProviderKey {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String    @default("openai")
  encryptedKey    String
  keyHint         String // last 4 characters
  lastValidatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, provider])
}

model ResearchJob {
  id              String         @id @default(cuid())
  kind            String // BRIEF | REFRESH | INTAKE
  status          String         @default("QUEUED") // QUEUED | RUNNING | SUCCEEDED | FAILED | CANCELLED
  certificationId String?
  certification   Certification? @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  intakeSessionId String?
  requestedById   String
  requestedBy     User           @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  useServerKey    Boolean        @default(false)
  progress        String         @default("[]") // JSON [{ at: ISO, message }]
  error           String?
  resultBriefId   String?
  inputTokens     Int?
  outputTokens    Int?
  createdAt       DateTime       @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  @@index([status, createdAt])
  @@index([certificationId, createdAt])
  @@index([requestedById, createdAt])
}

model StudyBrief {
  id              String              @id @default(cuid())
  certificationId String
  certification   Certification       @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  version         Int
  status          String              @default("CURRENT") // CURRENT | SUPERSEDED
  content         String // JSON StudyBriefContent
  model           String
  sourceCount     Int                 @default(0)
  inputTokens     Int?
  outputTokens    Int?
  jobId           String?
  requestedById   String
  requestedBy     User                @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  generatedAt     DateTime            @default(now())
  progress        ChecklistProgress[]
  feedback        BriefFeedback[]

  @@unique([certificationId, version])
  @@index([certificationId, status])
}

model ChecklistProgress {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  briefId         String
  brief           StudyBrief    @relation(fields: [briefId], references: [id], onDelete: Cascade)
  itemId          String // checklist item id (stable slug produced by the structuring step)
  completedAt     DateTime      @default(now())

  @@unique([userId, certificationId, itemId])
}

model BriefFeedback {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  briefId   String
  brief     StudyBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  itemType  String // brief | checklist | gap | resource | skill | learning_path
  itemId    String // "brief" for whole-brief feedback
  verdict   String // accurate | inaccurate | outdated
  comment   String     @default("")
  createdAt DateTime   @default(now())

  @@unique([userId, briefId, itemType, itemId])
  @@index([briefId])
}

model UserCertification {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  status          String        @default("STUDYING") // PLANNING | STUDYING | PASSED
  targetDate      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, certificationId])
}

model IntakeSession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputText     String   @default("")
  attachments   String   @default("[]") // JSON [{ name, mimeType, size, chars }]
  extractedText String   @default("")
  status        String   @default("QUEUED") // QUEUED | RUNNING | SUCCEEDED | FAILED
  result        String? // JSON IntakeResult
  model         String?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
}
