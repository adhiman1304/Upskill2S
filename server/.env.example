PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DEV_AUTH_BYPASS=false
TENANT_ID=
API_AUDIENCE=
# Comma-separated Entra object IDs. For local bypass admin testing, use local-developer.
ADMIN_OBJECT_IDS=
DATABASE_URL=file:./dev.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
# AI research (BYO OpenAI key). 32+ random chars; required unless DEV_AUTH_BYPASS=true (dev fallback derives one and warns)
KEY_ENCRYPTION_SECRET=
OPENAI_RESEARCH_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-5-mini
# Optional; enables scheduled refresh and admin "refresh all stale"
OPENAI_SERVER_API_KEY=
# Across all Stage A investigations of one brief
RESEARCH_MAX_WEB_SEARCHES=16
BRIEF_STALE_DAYS=30
BLOCKED_RESEARCH_DOMAINS=examtopics.com,braindumps.com,dumpsbase.com,pass4sure.com,exam-labs.com,itexams.com,certlibrary.com
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 3 * * *
INTAKE_MAX_FILES=3
INTAKE_MAX_FILE_BYTES=10485760
