# API port and the browser origin allowed by CORS (the Vite dev server).
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Local development only: skip Entra sign-in. Must match VITE_DEV_AUTH_BYPASS=true in client/.env.
# Rejected when NODE_ENV=production.
DEV_AUTH_BYPASS=false
# Entra tenant and API audience; required unless DEV_AUTH_BYPASS=true.
TENANT_ID=
API_AUDIENCE=
# Comma-separated Entra object IDs. For local bypass admin testing, use local-developer.
ADMIN_OBJECT_IDS=

# SQLite database (relative to server/) and private upload folder for legacy PDFs.
# Only one API process may run against one SQLite database at a time (the job worker claims jobs from it).
DATABASE_URL=file:./dev.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Encrypts users' OpenAI keys at rest (AES-256-GCM). 32+ random characters, for example `openssl rand -base64 48`.
# Required unless DEV_AUTH_BYPASS=true (a fixed development-only fallback is used then, with a warning).
# Changing it makes every stored key unreadable; users must save their key again.
KEY_ENCRYPTION_SECRET=

# OpenAI models (Responses API). Research runs the web-search investigations, the brief structuring step
# and intake recommendations; the fast model is reserved for quick tasks. Checked against
# developers.openai.com/api/docs/models on 2026-10-21: gpt-6-astra is the flagship, gpt-6.1-sol is a
# cheaper near-flagship option, gpt-6-luna is the most efficient model.
OPENAI_RESEARCH_MODEL=gpt-6-astra
OPENAI_FAST_MODEL=gpt-6-luna
# Optional company key. Enables the nightly scheduled refresh and the admin "Refresh all stale" button.
# Without it, research only runs with each user's own key (set in /settings).
OPENAI_SERVER_API_KEY=

# Web searches allowed across the four investigations of one brief (split evenly, at least 1 each).
RESEARCH_MAX_WEB_SEARCHES=16
# A brief older than this many days is shown as stale.
BRIEF_STALE_DAYS=30
# Exam-dump sites excluded from research results (a host matches the domain or any subdomain).
BLOCKED_RESEARCH_DOMAINS=examtopics.com,braindumps.com,dumpsbase.com,pass4sure.com,exam-labs.com,itexams.com,certlibrary.com

# Nightly refresh of stale briefs for followed certifications (max 10 per run).
# Runs only when SCHEDULER_ENABLED=true AND OPENAI_SERVER_API_KEY is set; otherwise /admin/ops only reports staleness.
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 3 * * *

# Intake uploads (PDF, DOCX, TXT, MD). The client hardcodes 3 files / 10 MB in IntakePage.tsx; keep them in sync.
INTAKE_MAX_FILES=3
INTAKE_MAX_FILE_BYTES=10485760
